# ---- Java / Maven ----
**/target/
*.class
*.jar
!**/src/**/*.jar
hs_err_pid*
*.hprof

# ---- Node / frontend ----
frontend/node_modules/
frontend/dist/
npm-debug.log*

# ---- Runtime data (H2 file DB, logs) ----
data/
*.mv.db
*.log

# ---- Editors / OS ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- Deployment / auth ----
.vercel/
.freebuff/

# ---- Local secrets (never commit) ----
.env-local.txt

.vercel
.env*.local

# Any plain .env holds real credentials — `supabase link` writes the database
# password there, and DATABASE_URL / DATABASE_PASSWORD are production secrets.
# Only the explicit *.example templates are allowed to be tracked.
.env
.env.*
!.env.example
!.env.*.example
